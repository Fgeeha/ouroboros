      ],
      "expected": [
        {"handle": "cursor=grok-4.6/high", "roster": "cursor=grok-4.6/high~fast-scout", "same_engine_as": null},
        {"handle": "cursor=grok-4.6/high", "roster": "cursor=grok-4.6/high~fast-scout_copy_pls35j", "same_engine_as": 0},
        {"handle": "moonshotai/kimi-k3", "roster": "moonshotai/kimi-k3", "same_engine_as": null}
      ]
    }
  ]
}
