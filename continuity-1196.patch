+def _fenced_member(workers, task_id, root_task_id):
+    member = {"id": task_id, "type": "task", "chat_id": 0, "root_task_id": root_task_id,
+              "parent_task_id": root_task_id, "_attempt": 1}
+    workers.PENDING.append(member)
+    return member
