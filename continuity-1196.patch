+    from ouroboros.gateway.settings import _api_settings_post_locked
+
+    for key in BOUNDS:
+        for bad in ("", None, "0", 0, "-1", "1.5", "none", "soon", True):
+            response = _api_settings_post_locked(_request(), {key: bad})
